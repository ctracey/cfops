#!/usr/bin/env bash
set -euo pipefail

VERSION="0.4.4"

case "${1:-}" in
  -v) echo "cfops $VERSION" ;;
  init)
    if [[ -f .envrc ]]; then
      echo ".envrc already exists — nothing to do."
      exit 0
    fi
    read -rp "Bitwarden machine account name: " account_name
    cat > .envrc <<EOF
export BWS_PROFILE_NAME=bws_${account_name}
export BWS_ACCESS_TOKEN=\$(security find-generic-password -s "\$BWS_PROFILE_NAME" -w)
EOF
    echo -e "\033[32m✓\033[0m .envrc created"
    if ! grep -qxF '.envrc' .gitignore 2>/dev/null; then
      echo ".envrc" >> .gitignore
      echo -e "\033[32m✓\033[0m .envrc added to .gitignore"
    fi
    echo -e "\033[34m→\033[0m ACTION: run 'direnv allow' to activate. (HINT: this will attempt to read BWS_ACCESS_TOKEN from Keychain — if configured you should see a password prompt)"
    if command -v node &>/dev/null; then
      node_major=$(node --version | sed 's/v\([0-9]*\).*/\1/')
      if [[ "$node_major" -lt 22 ]]; then
        echo -e "\033[34m→\033[0m ACTION: node version is $( node --version ) — wrangler requires node 22 or higher."
      fi
    fi
    echo "  HINT: test working with: cfops -wr whoami"
    ;;
  -tf)
    shift
    [ -z "${BWS_ACCESS_TOKEN:-}" ] && eval "$(direnv export bash)"
    if [[ -z "${BWS_ACCESS_TOKEN:-}" ]]; then
      echo -e "\033[31m✗\033[0m BWS_ACCESS_TOKEN could not be loaded. Check that the BWS_PROFILE_NAME in .envrc matches the Keychain item name." >&2
      echo -e "\033[34m→\033[0m See docs/usage.md section 1.4 to set up Keychain access." >&2
      exit 1
    fi
    bws run -- terraform "$@"
    ;;
  -wr)
    shift
    [ -z "${BWS_ACCESS_TOKEN:-}" ] && eval "$(direnv export bash)"
    if [[ -z "${BWS_ACCESS_TOKEN:-}" ]]; then
      echo -e "\033[31m✗\033[0m BWS_ACCESS_TOKEN could not be loaded. Check that the BWS_PROFILE_NAME in .envrc matches the Keychain item name." >&2
      echo -e "\033[34m→\033[0m See docs/usage.md section 1.4 to set up Keychain access." >&2
      exit 1
    fi
    bws run -- wrangler "$@"
    ;;
  *)
    echo "Usage: cfops init | cfops -tf|-wr [args]" >&2
    exit 1
    ;;
esac
